NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# PayMongo server credentials. Use matching test or live credentials per deployment.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Transactional booking, prescription and appointment-reminder notifications.
APP_URL=https://thekliniqueph.com
RESEND_API_KEY=
RESEND_FROM=The Klinique <no-reply@thekliniqueph.com>
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=
# Match this server-only random secret (32+ characters) in Supabase Vault.
# Vercel Hobby setup: docs/sql/setup-appointment-reminders.sql
CRON_SECRET=

# Embedded Zoom: two apps belonging to the clinic's Zoom account (server only).
# Setup: docs/embedded-zoom.md
ZOOM_MEETING_SDK_CLIENT_ID=
ZOOM_MEETING_SDK_CLIENT_SECRET=
ZOOM_ACCOUNT_ID=
ZOOM_SERVER_TO_SERVER_CLIENT_ID=
ZOOM_SERVER_TO_SERVER_CLIENT_SECRET=

# EmailJS browser credentials for the landing-page contact form.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
